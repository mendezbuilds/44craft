# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (sandbox: onboarding@resend.dev, sends only to your own account email)
RESEND_API_KEY=

# Where /contact form submissions get emailed. In Resend sandbox mode this
# MUST be the email address on your Resend account, or sends will fail.
CONTACT_EMAIL_TO=

# Where "a profile edit needs review" admin notifications get emailed —
# kept separate from CONTACT_EMAIL_TO on purpose (inbound leads and
# internal review pings don't have to land in the same inbox). Optional:
# if unset, this one notification just doesn't send — submitting a
# profile edit itself never depends on it.
ADMIN_NOTIFICATION_EMAIL=

# Postgres connection strings for Prisma (Supabase Project Settings > Database)
# DATABASE_URL: pooled connection (used by the app at runtime)
# DIRECT_URL: direct connection (used by Prisma Migrate)
DATABASE_URL=
DIRECT_URL=

# Base URL used to build invite/accept links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time bootstrap admin seed (scripts/seed-admin.ts) — not read at runtime
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
